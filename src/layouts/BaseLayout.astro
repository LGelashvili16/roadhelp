---
import "../styles/global.css";
import {
  contact,
  getLocalizedPath,
  localeOptions,
  type Locale,
  type PageKey,
} from "../content/site";

interface Props {
  locale: Locale;
  page: PageKey;
  title: string;
  description: string;
  designContract?: string;
}

const { locale, page, title, description, designContract } = Astro.props;
const canonicalPath = getLocalizedPath(page, locale);
const canonical = new URL(canonicalPath, Astro.site);
const siteUrl = new URL("/", Astro.site);
const sitemapUrl = new URL("/sitemap-index.xml", Astro.site);
const socialImage = new URL("/social-card.jpg", Astro.site);
const openGraphLocales: Record<Locale, string> = {
  ka: "ka_GE",
  en: "en_US",
  ru: "ru_RU",
};

const pageTypes: Record<PageKey, "WebPage" | "AboutPage" | "ContactPage"> = {
  home: "WebPage",
  about: "AboutPage",
  contact: "ContactPage",
};
const websiteId = new URL("/#website", Astro.site).href;
const businessId = new URL("/#business", Astro.site).href;
const webPageId = `${canonical.href}#webpage`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: siteUrl.href,
      name: "RoadHelp",
      inLanguage: localeOptions.map((option) => option.code),
    },
    {
      "@type": "AutomotiveBusiness",
      "@id": businessId,
      name: "RoadHelp",
      url: siteUrl.href,
      image: socialImage.href,
      telephone: contact.phoneHref,
      areaServed: [
        { "@type": "City", name: "Tbilisi" },
        { "@type": "Country", name: "Georgia" },
      ],
      availableLanguage: localeOptions.map((option) => option.code),
    },
    {
      "@type": pageTypes[page],
      "@id": webPageId,
      url: canonical.href,
      name: title,
      description,
      inLanguage: locale,
      isPartOf: { "@id": websiteId },
      about: { "@id": businessId },
    },
  ],
};
---

<!doctype html>
<html lang={locale} dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#15191d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={sitemapUrl} />
    {localeOptions.map((option) => (
      <link
        rel="alternate"
        hreflang={option.code}
        href={new URL(getLocalizedPath(page, option.code), Astro.site)}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(getLocalizedPath(page, "ka"), Astro.site)}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RoadHelp" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={openGraphLocales[locale]} />
    {localeOptions
      .filter((option) => option.code !== locale)
      .map((option) => (
        <meta property="og:locale:alternate" content={openGraphLocales[option.code]} />
      ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={title} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <title>{title}</title>
  </head>
  <body>
    {designContract && <Fragment set:html={`<!-- ${designContract} -->`} />}
    <slot />
  </body>
</html>
