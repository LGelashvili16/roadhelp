---
import Logo from "./Logo.astro";
import type { Locale, PageKey } from "../content/site";
import {
  contact,
  copy,
  getLocalizedPath,
  localeOptions,
} from "../content/site";

interface Props {
  locale: Locale;
  page: PageKey;
}

const { locale, page } = Astro.props;
const t = copy[locale];
const homePath = getLocalizedPath("home", locale);
const sectionHref = (section: string) =>
  page === "home" ? `#${section}` : `${homePath}#${section}`;
---

<header class="site-header">
  <div class="shell nav-inner">
    <Logo href={homePath} label={t.nav.home} />
    <nav class="desktop-nav" aria-label={t.nav.primaryLabel}>
      <a
        href={getLocalizedPath("about", locale)}
        aria-current={page === "about" ? "page" : undefined}
      >
        {t.nav.about}
      </a>
      <a href={sectionHref("services")}>{t.nav.services}</a>
      <a href={sectionHref("coverage")}>{t.nav.coverage}</a>
      <a href={sectionHref("process")}>{t.nav.process}</a>
    </nav>
    <div class="nav-actions">
      <a class="button button-small" href={`tel:${contact.phoneHref}`}>
        {t.nav.call}
      </a>
      <nav class="locale-switcher" aria-label={t.nav.languages}>
        {localeOptions.map((option) => (
          <a
            class="locale-link"
            class:list={{ active: option.code === locale }}
            href={getLocalizedPath(page, option.code)}
            hreflang={option.code}
            lang={option.code}
            aria-current={option.code === locale ? "page" : undefined}
            aria-label={option.label}
          >
            {option.shortLabel}
          </a>
        ))}
      </nav>
      <details class="mobile-menu">
        <summary>{t.nav.menu}</summary>
        <nav aria-label={t.nav.mobileLabel}>
          <a
            href={getLocalizedPath("about", locale)}
            aria-current={page === "about" ? "page" : undefined}
          >
            {t.nav.about}
          </a>
          <a href={sectionHref("services")}>{t.nav.services}</a>
          <a href={sectionHref("coverage")}>{t.nav.coverage}</a>
          <a href={sectionHref("process")}>{t.nav.process}</a>
          {localeOptions.map((option) => (
            <a
              href={getLocalizedPath(page, option.code)}
              hreflang={option.code}
              lang={option.code}
              aria-current={option.code === locale ? "page" : undefined}
            >
              {option.label}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>
