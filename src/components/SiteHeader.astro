---
import Logo from "./Logo.astro";
import type { Locale } from "../content/site";
import { contact, copy, localeOptions } from "../content/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
---

<header class="site-header">
  <div class="shell nav-inner">
    <Logo href={t.path} label={t.nav.home} />
    <nav class="desktop-nav" aria-label={t.nav.primaryLabel}>
      <a href="#services">{t.nav.services}</a>
      <a href="#coverage">{t.nav.coverage}</a>
      <a href="#process">{t.nav.process}</a>
    </nav>
    <div class="nav-actions">
      <nav class="locale-switcher" aria-label={t.nav.languages}>
        {localeOptions.map((option) => (
          <a
            class="locale-link"
            class:list={{ active: option.code === locale }}
            href={option.path}
            hreflang={option.code}
            lang={option.code}
            aria-current={option.code === locale ? "page" : undefined}
            aria-label={option.label}
          >
            {option.shortLabel}
          </a>
        ))}
      </nav>
      <a class="button button-small" href={`tel:${contact.phoneHref}`}>
        {t.nav.call}
      </a>
      <details class="mobile-menu">
        <summary>{t.nav.menu}</summary>
        <nav aria-label={t.nav.mobileLabel}>
          <a href="#services">{t.nav.services}</a>
          <a href="#coverage">{t.nav.coverage}</a>
          <a href="#process">{t.nav.process}</a>
          {localeOptions.map((option) => (
            <a
              href={option.path}
              hreflang={option.code}
              lang={option.code}
              aria-current={option.code === locale ? "page" : undefined}
            >
              {option.label}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>
