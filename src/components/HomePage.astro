---
import { Image } from "astro:assets";
import heroImage from "../assets/roadhelp-tbilisi-hero.png";
import regionImage from "../assets/roadhelp-region.png";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import { contact, copy, type Locale } from "../content/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
---

<BaseLayout locale={locale} page="home" title={t.seo.title} description={t.seo.description}>
  <SiteHeader locale={locale} page="home" />

  <main>
    <section class="hero">
      <Image
        class="hero-image"
        src={heroImage}
        alt={t.media.heroAlt}
        widths={[768, 1200, 1800]}
        sizes="100vw"
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero-scrim"></div>
      <div class="shell hero-inner">
        <div class="hero-copy reveal">
          <p class="eyebrow">{t.hero.eyebrow}</p>
          <h1>{t.hero.title}</h1>
          <p class="hero-description">{t.hero.description}</p>
          <div class="button-row">
            <a class="button" href={`tel:${contact.phoneHref}`}>{t.hero.primary}</a>
            <a class="text-link" href="#services">{t.hero.secondary}<span aria-hidden="true">↘</span></a>
          </div>
        </div>
      </div>
    </section>

    <section class="trust-strip" aria-label={t.media.trustLabel}>
      <div class="shell trust-grid">
        {t.trust.map((item) => <p>{item}</p>)}
      </div>
    </section>

    <section class="section intro-section" id="services">
      <div class="shell">
        <div class="section-heading reveal">
          <h2>{t.intro.title}</h2>
          <p>{t.intro.body}</p>
        </div>
        <div class="service-list">
          {t.services.map((service) => (
            <article class="service-row reveal">
              <span class="service-number">{service.number}</span>
              <h3>{service.title}</h3>
              <p>{service.body}</p>
              <a href={`tel:${contact.phoneHref}`} aria-label={`${t.nav.call}: ${service.title}`}>
                <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section coverage-section" id="coverage">
      <div class="shell coverage-grid">
        <div class="coverage-copy reveal">
          <h2>{t.coverage.title}</h2>
          <p>{t.coverage.body}</p>
          <div class="place-list">
            {t.coverage.places.map((place) => <span>{place}</span>)}
          </div>
          <small>{t.coverage.note}</small>
        </div>
        <figure class="coverage-image reveal">
          <Image
            src={regionImage}
            alt={t.media.regionAlt}
            widths={[640, 960, 1280]}
            sizes="(max-width: 767px) 100vw, 56vw"
            format="webp"
            loading="lazy"
          />
        </figure>
      </div>
    </section>

    <section class="section process-section" id="process">
      <div class="shell">
        <div class="section-heading compact reveal">
          <h2>{t.process.title}</h2>
        </div>
        <div class="process-grid">
          {t.process.items.map((item, index) => (
            <article class="process-item reveal">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section standards-section">
      <div class="shell standards-grid">
        <div class="standards-title reveal">
          <h2>{t.standards.title}</h2>
        </div>
        <div class="standards-body reveal">
          <p>{t.standards.body}</p>
          <div class="standards-list">
            {t.standards.items.map((item) => (
              <span><i aria-hidden="true"></i>{item}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section cta-section">
      <div class="shell cta-inner reveal">
        <h2>{t.cta.title}</h2>
        <p>{t.cta.body}</p>
        <p class="phone-display">{contact.phoneDisplay}</p>
        <div class="button-row centered">
          <a class="button" href={`tel:${contact.phoneHref}`}>{t.cta.primary}</a>
          <a class="button button-secondary" href={contact.whatsappHref} rel="noopener">{t.cta.secondary}</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter locale={locale} page="home" />
</BaseLayout>
