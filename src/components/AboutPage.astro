---
import { Image } from "astro:assets";
import aboutTruckImage from "../assets/roadhelp-about-truck.png";
import { aboutCopy } from "../content/about";
import {
  contact,
  getLocalizedPath,
  type Locale,
} from "../content/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = aboutCopy[locale];
const servicesHref = `${getLocalizedPath("home", locale)}#services`;
const designContract = `
THESIS: A service profile led by the real flatbed truck, refusing generic company-history and metric-card layouts.
OWN-WORLD: RoadHelp graphite surfaces, off-white type, orange route markers, hairline divisions, and large natural truck photography.
STORY: The visitor sees the vehicle, understands the flatbed method and coverage, then calls with the route details.
FIRST VIEWPORT: An absolute header sits over a split hero; service copy leads on the left, the truck fills the right, and the call action follows the description.
FORM: Photo-led flatbed profile, grounded candidate 7, seed 3023665d.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
`.trim();
---

<BaseLayout
  locale={locale}
  page="about"
  title={t.seo.title}
  description={t.seo.description}
  designContract={designContract}
>
  <SiteHeader locale={locale} page="about" />

  <main class="about-page">
    <section class="about-hero">
      <div class="shell about-hero-grid">
        <div class="about-hero-copy reveal">
          <h1>{t.hero.title}</h1>
          <p>{t.hero.body}</p>
          <div class="button-row">
            <a class="button" href={`tel:${contact.phoneHref}`}>{t.hero.primary}</a>
            <a class="text-link" href={servicesHref}>
              {t.hero.secondary}<span aria-hidden="true">↘</span>
            </a>
          </div>
        </div>

        <figure class="about-hero-media reveal">
          <Image
            src={aboutTruckImage}
            alt={t.media.truckAlt}
            widths={[720, 1080, 1536]}
            sizes="(max-width: 900px) 100vw, 56vw"
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
          <figcaption>{t.media.caption}</figcaption>
        </figure>
      </div>
    </section>

    <section class="section about-overview">
      <div class="shell about-overview-grid">
        <h2 class="reveal">{t.overview.title}</h2>
        <div class="about-overview-copy reveal">
          {t.overview.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    <section class="section about-approach">
      <div class="shell">
        <div class="section-heading compact reveal">
          <h2>{t.approach.title}</h2>
        </div>
        <div class="about-approach-list">
          {t.approach.items.map((item) => (
            <article class="about-approach-item reveal">
              <span aria-hidden="true"></span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section about-coverage">
      <div class="shell about-coverage-grid">
        <div class="about-coverage-copy reveal">
          <h2>{t.coverage.title}</h2>
          <p>{t.coverage.body}</p>
          <small>{t.coverage.note}</small>
        </div>
        <div class="about-place-list reveal">
          {t.coverage.places.map((place) => <span>{place}</span>)}
        </div>
      </div>
    </section>

    <section class="section cta-section">
      <div class="shell cta-inner reveal">
        <h2>{t.cta.title}</h2>
        <p>{t.cta.body}</p>
        <p class="phone-display">{contact.phoneDisplay}</p>
        <div class="button-row centered">
          <a class="button" href={`tel:${contact.phoneHref}`}>{t.cta.primary}</a>
          <a class="button button-secondary" href={contact.whatsappHref} rel="noopener">
            {t.cta.secondary}
          </a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter locale={locale} page="about" />
</BaseLayout>
